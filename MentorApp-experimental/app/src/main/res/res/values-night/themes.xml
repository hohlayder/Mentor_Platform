<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MentorApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorPrimaryVariant">@color/app_primary</item>
        <item name="colorSecondary">@color/app_secondary</item>

        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="materialButtonStyle">@style/Widget.MentorApp.Button</item>
        <item name="textInputStyle">@style/Widget.MentorApp.TextInputLayout</item>

        <item name="android:textColorPrimary">@color/app_on_surface</item>
        <item name="android:textColorSecondary">@color/app_on_surface_variant</item>
    </style>

    <style name="Widget.MentorApp.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.MentorApp.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>

        <item name="boxStrokeColor">@color/app_stroke</item>
        <item name="hintTextColor">@color/app_on_surface_variant</item>
        <item name="android:textColorHint">@color/app_on_surface_variant</item>
    </style>

</resources>
